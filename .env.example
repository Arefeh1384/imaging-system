# Copy this file to .env and change what you need. Then run:  docker compose up -d
# (Docker reads .env by itself. Lines starting with # are notes.)

# Seconds between the patient's «تأیید» and the check. The real service waits 30 to 60 minutes (1800 to 3600).
CHECK_DELAY_SECONDS=60
# Seconds before trying again when the AI service refused or failed (busy, cut off, no connection).
CHECK_RETRY_SECONDS=120

# fake = check without AI (compares the written details).
# openrouter = an AI model through OpenRouter looks at the pictures (Gemini by default).
# gemini = the same, straight through Google's Gemini API.
CHECKER=fake

# OpenRouter: key from openrouter.ai/keys. Any vision model on OpenRouter works, such as google/gemini-2.5-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Up to 3 models, separated by commas, are tried in order: the next is used when one is busy. For free testing:
# OPENROUTER_MODEL=openrouter/free  (picks an available free model that reads images)
# The longest answer allowed. Lower it if your credit is small.
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google's Gemini API directly, instead of OpenRouter:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# If the AI service is reached through your VPN's local proxy, for example v2rayN on port 10809:
# AI_PROXY=http://host.docker.internal:10809
AI_PROXY=

# Package sources, if the default ones are slow or blocked where you are.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# The insurance panel's first account, made the first time the backend starts.
INSURANCE_USERNAME=dana-admin
INSURANCE_PASSWORD=dana1234

# Change both if you change them at all.
PACS_API_KEY=dev-pacs-key
SECRET_KEY=local-only-secret-change-me
