# mock: uses local sample data in the browser (no backend needed)
# hybrid: the patient panel calls the backend; the admin and insurance panels stay on sample data
# http: everything calls the backend at VITE_API_BASE_URL
VITE_API_MODE=mock
# /api/v1 works with `npm run dev` (Vite passes it to port 8000) and inside Docker (nginx passes it to the backend).
VITE_API_BASE_URL=/api/v1
# Show the test accounts on the sign-in pages (test servers only).
VITE_DEMO_ACCOUNTS=false

# mock only: adds this many sample rows to the long lists, to see how they behave with a lot of data
# VITE_MOCK_EXTRA_ROWS=10000
